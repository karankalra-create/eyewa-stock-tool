# Copy this file to .streamlit/secrets.toml (git-ignored, never commit it) and
# fill in the real values from your Noon Partner service-account .json key —
# the same file you download from Noon's Access App under Add Service Account.
#
# For the deployed app, don't put secrets.toml on the server at all — paste this
# same [noon] block into the app's own Secrets panel on share.streamlit.io
# (App settings > Secrets).

[noon]
key_id = "your-noon-key-id"
private_key = """
-----BEGIN PRIVATE KEY-----
...paste the private_key value from the downloaded .json here, keeping the
real line breaks (Streamlit's TOML parser needs a literal multi-line string,
not an escaped \\n one)...
-----END PRIVATE KEY-----
"""
channel_identifier = "your-service-account@pXXXXX.idp.noon.partners"
project_code = "PRJXXXXX"
